// ============================================================
// SkillLoop - Prisma Schema
// Normalized PostgreSQL schema with enums, indexes, cascades
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum Role {
  ADMIN
  CREATOR
  LEARNER
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SkillStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CategoryName {
  PROGRAMMING
  DESIGN
  MARKETING
  FINANCE
  LANGUAGE
  MUSIC
  PHOTOGRAPHY
  BUSINESS
  OTHERS
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  REQUEST
  BOOKING
  REVIEW
  MESSAGE
  SYSTEM
}

// ------------------------------------------------------------
// USER & PROFILES
// ------------------------------------------------------------

model User {
  id       String  @id @default(uuid())
  name     String
  username String  @unique
  email    String  @unique
  password String
  phone    String?
  avatar   String?
  bio      String?

  role       Role    @default(LEARNER)
  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  emailVerifyToken   String?
  emailVerifyExpires DateTime?

  passwordResetToken   String?
  passwordResetExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  creatorProfile CreatorProfile?
  learnerProfile LearnerProfile?

  refreshTokens RefreshToken[]
  notifications Notification[]

  skillsCreated     Skill[]   @relation("CreatorSkills")
  requestsMade      Request[] @relation("LearnerRequests")
  bookingsAsLearner Booking[] @relation("LearnerBookings")
  bookingsAsCreator Booking[] @relation("CreatorBookings")

  reviewsWritten Review[] @relation("ReviewAuthor")

  conversationsA Conversation[] @relation("ParticipantOne")
  conversationsB Conversation[] @relation("ParticipantTwo")
  messagesSent   Message[]      @relation("MessageSender")

  reportsMade Report[] @relation("ReportedBy")

  @@index([role])
  @@index([email])
  @@index([username])
  @@map("users")
}

model CreatorProfile {
  id        String @id @default(uuid())
  creatorId String @unique
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  headline   String?
  experience String?
  skills     String[] @default([])
  linkedin   String?
  github     String?
  portfolio  String?

  rating      Float @default(0)
  ratingCount Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("creator_profiles")
}

model LearnerProfile {
  id        String @id @default(uuid())
  learnerId String @unique
  learner   User   @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  interests     String[]   @default([])
  learningGoals String[]   @default([])
  currentLevel  SkillLevel @default(BEGINNER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("learner_profiles")
}

// ------------------------------------------------------------
// AUTH
// ------------------------------------------------------------

model RefreshToken {
  id     String @id @default(uuid())
  token  String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent String?
  ip        String?
  revoked   Boolean  @default(false)
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ------------------------------------------------------------
// CATEGORIES & SKILLS
// ------------------------------------------------------------

model Category {
  id          String       @id @default(uuid())
  name        CategoryName @unique
  slug        String       @unique
  description String?
  icon        String?

  skills Skill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Skill {
  id          String      @id @default(uuid())
  title       String
  description String
  level       SkillLevel  @default(BEGINNER)
  price       Decimal     @default(0) @db.Decimal(10, 2)
  thumbnail   String?
  duration    Int // in minutes
  language    String      @default("English")
  status      SkillStatus @default(DRAFT)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  creatorId String
  creator   User   @relation("CreatorSkills", fields: [creatorId], references: [id], onDelete: Cascade)

  requests Request[]
  bookings Booking[]
  reviews  Review[]

  avgRating   Float @default(0)
  ratingCount Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([categoryId])
  @@index([status])
  @@index([title])
  @@map("skills")
}

// ------------------------------------------------------------
// REQUESTS & BOOKINGS
// ------------------------------------------------------------

model Request {
  id String @id @default(uuid())

  learnerId String
  learner   User   @relation("LearnerRequests", fields: [learnerId], references: [id], onDelete: Cascade)

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  message String?
  status  RequestStatus @default(PENDING)

  booking Booking?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([learnerId])
  @@index([skillId])
  @@index([status])
  @@map("requests")
}

model Booking {
  id String @id @default(uuid())

  requestId String  @unique
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  learnerId String
  learner   User   @relation("LearnerBookings", fields: [learnerId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation("CreatorBookings", fields: [creatorId], references: [id], onDelete: Cascade)

  scheduledAt DateTime?
  status      BookingStatus @default(PENDING)
  price       Decimal       @default(0) @db.Decimal(10, 2)

  review Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([learnerId])
  @@index([creatorId])
  @@index([skillId])
  @@index([status])
  @@map("bookings")
}

// ------------------------------------------------------------
// REVIEWS
// ------------------------------------------------------------

model Review {
  id String @id @default(uuid())

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  rating  Int // 1-5
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([skillId])
  @@index([authorId])
  @@map("reviews")
}

// ------------------------------------------------------------
// NOTIFICATIONS
// ------------------------------------------------------------

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String
  link    String?
  isRead  Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ------------------------------------------------------------
// CHAT
// ------------------------------------------------------------

model Conversation {
  id String @id @default(uuid())

  participantOneId String
  participantOne   User   @relation("ParticipantOne", fields: [participantOneId], references: [id], onDelete: Cascade)

  participantTwoId String
  participantTwo   User   @relation("ParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)

  messages Message[]

  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([participantOneId, participantTwoId])
  @@index([participantOneId])
  @@index([participantTwoId])
  @@map("conversations")
}

model Message {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  content String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

// ------------------------------------------------------------
// ADMIN / REPORTS
// ------------------------------------------------------------

model Report {
  id String @id @default(uuid())

  reportedById String
  reportedBy   User   @relation("ReportedBy", fields: [reportedById], references: [id], onDelete: Cascade)

  targetType String // "USER" | "SKILL" | "REVIEW"
  targetId   String
  reason     String
  resolved   Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@map("reports")
}
